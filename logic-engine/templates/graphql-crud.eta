{# GraphQL CRUD template — generates one of: search | find | create | update | delete
   See logic-engine/rules/graphql.md and logic-engine/rules/schema.md for the rules:
   - graphql-tables-fully-qualified: module tables carry modules/{name}/; app/schema tables use the file name
   - schema-property-functions: property(), property_int() etc.
   - use-related-record-for-joins: related_record() / related_records() for joins

   Params:
     operation       — search | find | create | update | delete
     resource        — fully-qualified table name (e.g. 'modules/insites_ecommerce/product' or 'product' if local)
     properties      — array of { name, type } for property() function selection
     related_records — optional array of { name, table, join_on_property, properties }
#}
<% if (it.operation === 'search') { -%>
query search($page: Int = 1, $limit: Int = 20<% it.properties.forEach(function(p) { -%>, $<%= p.name %>: <%= p.gql_type || 'String' %><% }) -%>) {
  records(
    page: $page
    per_page: $limit
    filter: {
      table: { value: "<%= it.resource %>" }
      properties: [
<% it.properties.forEach(function(p) { -%>
        { name: "<%= p.name %>", value: $<%= p.name %> }
<% }) -%>
      ]
    }
  ) {
    total_entries
    has_next_page
    results {
      id
      created_at
<% it.properties.forEach(function(p) { -%>
      <%= p.name %>: <%= p.accessor || ('property(name: "' + p.name + '")') %>
<% }) -%>
    }
  }
}
<% } else if (it.operation === 'find') { -%>
query find($id: ID!) {
  records(per_page: 1, filter: { id: { value: $id }, table: { value: "<%= it.resource %>" } }) {
    results {
      id
<% it.properties.forEach(function(p) { -%>
      <%= p.name %>: <%= p.accessor || ('property(name: "' + p.name + '")') %>
<% }) -%>
<% if (it.related_records) { -%>
<% it.related_records.forEach(function(r) { -%>
      <%= r.name %>: related_record(table: "<%= r.table %>", join_on_property: "<%= r.join_on_property %>") {
        id
<% (r.properties || []).forEach(function(p) { -%>
        <%= p.name %>: <%= p.accessor || ('property(name: "' + p.name + '")') %>
<% }) -%>
      }
<% }) -%>
<% } -%>
    }
  }
}
<% } else if (it.operation === 'create') { -%>
mutation create(<% it.properties.forEach(function(p, i) { -%>$<%= p.name %>: <%= p.gql_type || 'String' %><% if (p.required) { %>!<% } %><% if (i < it.properties.length - 1) { %>, <% } %><% }) -%>) {
  record_create(record: {
    table: "<%= it.resource %>"
    properties: [
<% it.properties.forEach(function(p) { -%>
      { name: "<%= p.name %>", value: $<%= p.name %> }
<% }) -%>
    ]
  }) {
    id
<% it.properties.forEach(function(p) { -%>
    <%= p.name %>: <%= p.accessor || ('property(name: "' + p.name + '")') %>
<% }) -%>
  }
}
<% } else if (it.operation === 'update') { -%>
mutation update($id: ID!<% it.properties.forEach(function(p) { -%>, $<%= p.name %>: <%= p.gql_type || 'String' %><% }) -%>) {
  record_update(id: $id, record: {
    table: "<%= it.resource %>"
    properties: [
<% it.properties.forEach(function(p) { -%>
      { name: "<%= p.name %>", value: $<%= p.name %> }
<% }) -%>
    ]
  }) {
    id
<% it.properties.forEach(function(p) { -%>
    <%= p.name %>: <%= p.accessor || ('property(name: "' + p.name + '")') %>
<% }) -%>
  }
}
<% } else if (it.operation === 'delete') { -%>
mutation delete($id: ID!) {
  record_delete(id: $id, table: "<%= it.resource %>") {
    id
  }
}
<% } -%>
